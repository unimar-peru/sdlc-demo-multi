#!/usr/bin/env sh
# Puerta del MENSAJE de commit: comprueba las referencias mientras aun se pueden
# corregir (SD-02).
#
# POR QUE EXISTE UN HOOK APARTE. `pre-commit` juzga `HEAD` y sus antecesores, es
# decir, todo menos el commit que se esta creando: su mensaje aun no existe. Una
# cita colgante pasaba esa puerta al escribirse y bloqueaba al SIGUIENTE commit,
# cuando el mensaje ya estaba publicado y corregirlo exigia reescribir historia.
# La puerta detectaba el defecto exactamente cuando dejaba de ser corregible.
# Ocurrio en `unimar-ums` el 2026-08-02: un mensaje que citaba un gap del padre
# dejo el repositorio sin poder commitear.
#
# Aqui el mensaje SI existe y todavia es tuyo: git te devuelve al editor.
#
# CITAS A OTRO REPOSITORIO. Un `G-287` a secas afirma que ese gap esta en el
# registro de ESTE repositorio. Si el hallazgo es del padre o de otro satelite,
# califica la cita: `unimar_arch#G-287`, `unimar_tms#ADR-TMS-004`. Escribirlo en
# prosa --«registrado como G-287 en unimar_arch»-- no basta: para un humano es
# claro, para el validador es indistinguible de una cita propia.
#
# ACTIVACION -- una sola vez por clon:
#   git config core.hooksPath .husky
#
# INSTALACION:
#   cp "$UNIMAR_CORE/templates/husky-commit-msg.sh" .husky/commit-msg
#   chmod +x .husky/commit-msg
#
# El hook local NO es la garantia: se evade con --no-verify. El limite de merge
# inevadible es el CI, si el satelite lo tiene.

set -e

# Localizar el estandar (plugin unimar-core), ultima version instalada.
UNIMAR_CORE=$(ls -d "$HOME"/.claude/plugins/cache/unimar/unimar-core/*/ 2>/dev/null | sort -V | tail -1)

if [ -z "$UNIMAR_CORE" ]; then
  echo "[husky] commit-msg: no se encontro el plugin unimar-core en el cache." >&2
  echo "        Instalalo o habilitalo antes de commitear." >&2
  exit 1
fi

# 1. Referencias del mensaje: G-NNN y ADR-NNNN deben resolver en este repositorio,
#    o venir calificadas con el repositorio al que pertenecen (SD-02).
node "${UNIMAR_CORE}/scripts/validate-trazabilidad.mjs" --mensaje "$1"

# 2. Aqui encadena el satelite su propio formato de commits.
#    Ejemplo Conventional Commits:
#      npx --yes commitlint@19 --edit "$1"

echo "[husky] commit-msg: referencias del mensaje OK (estandar via plugin)."
